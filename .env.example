# Run npm run setup to create .env and a permanent random encryption key.
DATABASE_URL="file:./data/vizor.db"
SELF_HOST="true"
APP_ORIGIN="http://127.0.0.1:3000"
# Required: exactly 32 random bytes, base64 encoded. Never replace after saving keys.
MASTER_KEY=""
NEXT_TELEMETRY_DISABLED="1"
CHECKPOINT_DISABLE="1"
