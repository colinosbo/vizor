generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
}
datasource db {
  provider = "sqlite"
}
model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  createdAt DateTime @default(now())
  sessions Session[]
  credentials Credential[]
  agents Agent[]
  runs Run[]
  templates AgentTemplate[]
  workspaceLayout String @default("{}")
  proposals Proposal[]
  audits AuditEntry[]
  budgets ProviderBudget[]
  budgetMonths BudgetMonth[]
  spending SpendEntry[]
  terminalDispatches TerminalDispatch[]
}
model Session {
  id String @id
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([userId])
}
model Credential {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  encrypted String
  last4 String
  updatedAt DateTime @updatedAt
  @@unique([userId, provider])
}
model Agent {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  engine String @default("api")
  projectPath String @default("")
  nativeSessionId String?
  terminalStarted Boolean @default(false)
  terminalState String @default("stopped")
  provider String @default("anthropic")
  model String
  systemPrompt String
  temperature Float @default(0.7)
  maxTokens Int @default(2048)
  color String @default("mint")
  icon String @default("spark")
  demo Boolean @default(false)
  paused Boolean @default(false)
  archived Boolean @default(false)
  kind String @default("agent")
  contextSummary String @default("")
  summaryThroughPosition Int @default(-1)
  createdAt DateTime @default(now())
  conversation Conversation?
  terminalDispatches TerminalDispatch[]
  @@index([userId])
}
model Conversation {
  id String @id @default(cuid())
  agentId String @unique
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  activeRunId String?
  messages Message[]
  runs Run[]
}
model Message {
  id String @id @default(cuid())
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  position Int
  role String
  text String
  status String @default("complete")
  origin String @default("user")
  proposalId String?
  createdAt DateTime @default(now())
  @@unique([conversationId, position])
}
model Run {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversationId String
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  clientId String
  assistantId String
  model String
  provider String @default("anthropic")
  status String @default("running")
  inputTokens Int?
  outputTokens Int?
  cost Float?
  usageComplete Boolean @default(false)
  errorCode String?
  proposalId String? @unique
  createdAt DateTime @default(now())
  endedAt DateTime?
  @@unique([userId, clientId])
  @@index([userId, conversationId])
}
model RateLimit {
  id String @id
  count Int @default(1)
  expiresAt DateTime
}
model AgentTemplate {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  config String
  createdAt DateTime @default(now())
  @@index([userId])
}
model Proposal {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  runId String
  toolCallId String
  action String
  agentId String?
  payload String
  status String @default("pending")
  version Int @default(0)
  origin String @default("user_request")
  approvedBy String?
  approvedAt DateTime?
  resultRunId String?
  error String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([runId, toolCallId])
  @@index([userId, status, createdAt])
}
model TerminalDispatch {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId String
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  proposalId String @unique
  text String
  status String @default("ready")
  error String?
  claimedAt DateTime?
  deliveredAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, status, createdAt])
  @@index([agentId, status])
}
model AuditEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  actor String
  action String
  subjectId String?
  proposalId String?
  approvedBy String?
  details String @default("{}")
  createdAt DateTime @default(now())
  @@index([userId, createdAt])
}
model ProviderBudget {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  limitMicros BigInt?
  updatedAt DateTime @updatedAt
  @@unique([userId, provider])
}
model BudgetMonth {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  period String
  spentMicros BigInt @default(0)
  reservedMicros BigInt @default(0)
  unknownCalls Int @default(0)
  @@unique([userId, provider, period])
}
model SpendEntry {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider String
  model String
  source String
  referenceId String?
  period String
  status String @default("reserved")
  quotedMicros BigInt @default(0)
  chargedMicros BigInt?
  inputTokens Int?
  outputTokens Int?
  inputRate Float?
  outputRate Float?
  estimated Boolean @default(true)
  createdAt DateTime @default(now())
  settledAt DateTime?
  @@index([userId, provider, period])
}
